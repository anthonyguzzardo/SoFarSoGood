#!/bin/bash
# Quick commit and push for niac-atlas
# Usage: ./so "commit message"

if [ -z "$1" ]; then
  echo "Usage: ./so \"commit message\""
  exit 1
fi

git add .
git stash
git pull origin main --rebase
git stash pop
git add .
git diff --cached --quiet || git commit -m "$1"
git push origin main
