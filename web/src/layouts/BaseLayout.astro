---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import { allConcepts } from "../lib/concepts.ts";

interface Props {
  title: string;
  description?: string;
  /** Active nav item — drives the underline/highlight in the header. */
  nav?: "browse" | "timeline" | "subjects" | "atlas" | "explore" | "paths" | "wishlist" | "mission" | "concept" | null;
}

const {
  title,
  description = "An atlas of every future humans have seriously imagined.",
  nav = null,
} = Astro.props;

/** Slug list for the random-concept button — injected once into the page. */
const allSlugs = allConcepts.map((c) => c.slug);

/** Each nav item: label, href, key for active-state matching. */
const navItems = [
  { key: "browse", label: "Browse", href: "/" },
  { key: "explore", label: "Explore", href: "/explore" },
  { key: "paths", label: "Paths", href: "/paths" },
  { key: "wishlist", label: "Wishlist", href: "/wishlist" },
  { key: "mission", label: "Mission", href: "/mission" },
] as const;

const viewItems = [
  { key: "timeline", label: "Timeline", href: "/timeline" },
  { key: "atlas", label: "Atlas", href: "/atlas" },
  { key: "subjects", label: "Subjects", href: "/subjects" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛰</text></svg>"
    />
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col relative">
    {/* Ambient background — fixed, behind everything. */}
    <div class="starfield"></div>
    <div class="starfield-vignette"></div>

    {/* ----------------------------------------------------------------- */}
    {/* Header                                                            */}
    {/* ----------------------------------------------------------------- */}
    <header class="border-b hairline relative z-10 backdrop-blur-sm">
      <div
        class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between gap-6 flex-wrap"
      >
        <a href="/" class="inline-block group">
          <h1 class="text-2xl font-semibold tracking-tight font-display">
            NIAC <span class="text-accent">Atlas</span>
          </h1>
          <p class="text-xs text-dim mt-0.5">
            an atlas of imagined futures
          </p>
        </a>

        <nav class="flex items-center gap-1 flex-wrap">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "px-3 py-2 text-xs uppercase tracking-widest font-mono rounded transition",
                  nav === item.key
                    ? "text-accent border hairline-strong"
                    : "text-dim hover:text-white border border-transparent",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <span class="text-faint mx-1 text-xs">·</span>
          {
            viewItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "px-2 py-1.5 text-[0.6rem] uppercase tracking-widest font-mono rounded transition",
                  nav === item.key
                    ? "text-accent border hairline-strong"
                    : "text-faint hover:text-dim border border-transparent",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="random-concept-btn"
            type="button"
            class="ml-2 px-3 py-2 text-xs uppercase tracking-widest font-mono rounded border hairline hover:border-amber-400 hover:text-accent transition text-dim"
          >
            ↯ Random
          </button>
        </nav>
      </div>
    </header>

    <main class="flex-1 max-w-6xl w-full mx-auto px-6 py-12 relative z-10">
      <slot />
    </main>

    <footer class="border-t hairline mt-24 relative z-10">
      <div class="max-w-6xl mx-auto px-6 py-8 text-xs text-dim font-mono">
        <p>
          Concepts sourced from
          <a
            href="https://ntrs.nasa.gov"
            class="underline hover:text-white"
            target="_blank"
            rel="noopener">NASA Technical Reports Server</a
          >. NIAC = NASA Innovative Advanced Concepts. Not affiliated with NASA.
        </p>
      </div>
    </footer>

    {/* Scroll progress bar */}
    <div class="scroll-progress" aria-hidden="true"></div>

    {/* Inline script for the random-concept button. No React, no hydration. */}
    <script is:inline define:vars={{ allSlugs }}>
      const btn = document.getElementById("random-concept-btn");
      if (btn) {
        btn.addEventListener("click", () => {
          const slug =
            allSlugs[Math.floor(Math.random() * allSlugs.length)];
          window.location.href = `/concept/${slug}`;
        });
      }
    </script>

    {/* Scroll-reveal observer — watches .reveal elements, adds .revealed on viewport entry. */}
    <script is:inline>
      function initReveals() {
        var els = document.querySelectorAll(".reveal");
        if (!els.length) return;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach(function (el) { observer.observe(el); });
      }
      initReveals();
      document.addEventListener("astro:after-swap", initReveals);
    </script>

    {/* Scroll progress bar updater. */}
    <script is:inline>
      function initProgress() {
        var bar = document.querySelector(".scroll-progress");
        if (!bar) return;
        function update() {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          var pct = h > 0 ? (window.scrollY / h) * 100 : 0;
          bar.style.setProperty("--scroll", pct + "%");
        }
        window.addEventListener("scroll", update, { passive: true });
        update();
      }
      initProgress();
      document.addEventListener("astro:after-swap", initProgress);
    </script>
  </body>
</html>
