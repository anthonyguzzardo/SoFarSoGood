---
/**
 * ConceptIcon — SVG symbol for a concept category.
 *
 * Renders a minimal line-art icon representing the concept's scientific
 * domain. Used in concept page headers to give visual variety.
 */

import type { ConceptCategory } from "../lib/concepts.ts";

interface Props {
  category: ConceptCategory;
  size?: number;
}

const { category, size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  style="color: var(--color-accent); opacity: 0.7;"
  aria-hidden="true"
>
  {category === "propulsion" && (
    <Fragment>
      {/* Rocket / flame */}
      <path d="M12 2 L8 10 L12 8 L16 10 Z" />
      <path d="M10 10 L8 16" />
      <path d="M14 10 L16 16" />
      <path d="M9 18 L12 14 L15 18" />
      <path d="M10 20 L12 17 L14 20" />
    </Fragment>
  )}
  {category === "telescope" && (
    <Fragment>
      {/* Telescope / lens */}
      <circle cx="12" cy="12" r="4" />
      <circle cx="12" cy="12" r="8" stroke-dasharray="2 3" />
      <line x1="12" y1="4" x2="12" y2="1" />
      <line x1="12" y1="20" x2="12" y2="23" />
      <line x1="4" y1="12" x2="1" y2="12" />
      <line x1="20" y1="12" x2="23" y2="12" />
    </Fragment>
  )}
  {category === "habitat" && (
    <Fragment>
      {/* Dome / shelter */}
      <path d="M3 18 Q3 6 12 4 Q21 6 21 18" />
      <line x1="3" y1="18" x2="21" y2="18" />
      <line x1="12" y1="4" x2="12" y2="18" />
      <path d="M7 18 L7 13" />
      <path d="M17 18 L17 13" />
    </Fragment>
  )}
  {category === "planetary" && (
    <Fragment>
      {/* Planet with ring */}
      <circle cx="12" cy="12" r="5" />
      <ellipse cx="12" cy="12" rx="10" ry="3" transform="rotate(-20 12 12)" stroke-dasharray="3 2" />
    </Fragment>
  )}
  {category === "life-detection" && (
    <Fragment>
      {/* Microbe / cell */}
      <circle cx="12" cy="12" r="6" />
      <circle cx="10" cy="10" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="14" cy="13" r="1" fill="currentColor" stroke="none" />
      <path d="M6 12 L2 10" />
      <path d="M18 12 L22 10" />
      <path d="M12 6 L10 2" />
    </Fragment>
  )}
  {category === "power" && (
    <Fragment>
      {/* Lightning bolt */}
      <path d="M13 2 L7 12 L11 12 L9 22 L17 10 L13 10 Z" />
    </Fragment>
  )}
  {category === "communication" && (
    <Fragment>
      {/* Signal waves */}
      <circle cx="6" cy="18" r="2" />
      <path d="M10 14 A6 6 0 0 0 6 8" />
      <path d="M14 10 A10 10 0 0 0 6 4" />
      <path d="M18 6 A14 14 0 0 0 6 0" />
    </Fragment>
  )}
  {category === "defense" && (
    <Fragment>
      {/* Shield */}
      <path d="M12 2 L20 6 L20 12 C20 17 16 21 12 22 C8 21 4 17 4 12 L4 6 Z" />
      <path d="M12 8 L12 16" />
      <path d="M8 12 L16 12" />
    </Fragment>
  )}
  {category === "robotics" && (
    <Fragment>
      {/* Robot / bot */}
      <rect x="6" y="8" width="12" height="10" rx="2" />
      <circle cx="9.5" cy="13" r="1.5" />
      <circle cx="14.5" cy="13" r="1.5" />
      <line x1="12" y1="4" x2="12" y2="8" />
      <circle cx="12" cy="3" r="1" />
      <line x1="4" y1="12" x2="6" y2="12" />
      <line x1="18" y1="12" x2="20" y2="12" />
    </Fragment>
  )}
  {category === "manufacturing" && (
    <Fragment>
      {/* 3D print layers */}
      <path d="M4 16 L12 20 L20 16" />
      <path d="M4 12 L12 16 L20 12" />
      <path d="M4 8 L12 12 L20 8" />
      <path d="M4 8 L12 4 L20 8" />
    </Fragment>
  )}
  {category === "other" && (
    <Fragment>
      {/* Star / generic */}
      <path d="M12 2 L14 9 L21 9 L15.5 13.5 L17.5 21 L12 16.5 L6.5 21 L8.5 13.5 L3 9 L10 9 Z" />
    </Fragment>
  )}
</svg>
