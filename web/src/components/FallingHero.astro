---
/**
 * FallingHero — the falling man.
 *
 * Full-viewport cinematic intro: a silhouette tumbles through void,
 * wind lines stream upward, the quote fades in.
 * Pure CSS animation — no libraries, no JS (except scroll hint dismiss).
 */
---

<section class="falling-hero" id="falling-hero">
  {/* Wind lines — vertical streaks rushing upward to sell the fall */}
  <div class="wind-lines" aria-hidden="true">
    <div class="wind-line" style="--x: 8%; --delay: 0s; --speed: 1.1s; --h: 90px;"></div>
    <div class="wind-line" style="--x: 15%; --delay: 0.7s; --speed: 1.4s; --h: 60px;"></div>
    <div class="wind-line" style="--x: 23%; --delay: 0.3s; --speed: 0.9s; --h: 110px;"></div>
    <div class="wind-line" style="--x: 31%; --delay: 1.1s; --speed: 1.3s; --h: 70px;"></div>
    <div class="wind-line" style="--x: 40%; --delay: 0.5s; --speed: 1.0s; --h: 85px;"></div>
    <div class="wind-line" style="--x: 52%; --delay: 0.2s; --speed: 1.5s; --h: 55px;"></div>
    <div class="wind-line" style="--x: 61%; --delay: 0.9s; --speed: 1.1s; --h: 100px;"></div>
    <div class="wind-line" style="--x: 70%; --delay: 1.3s; --speed: 0.8s; --h: 75px;"></div>
    <div class="wind-line" style="--x: 78%; --delay: 0.4s; --speed: 1.2s; --h: 65px;"></div>
    <div class="wind-line" style="--x: 87%; --delay: 0.8s; --speed: 1.0s; --h: 95px;"></div>
    <div class="wind-line" style="--x: 93%; --delay: 1.5s; --speed: 1.3s; --h: 50px;"></div>
  </div>

  {/* The falling figure */}
  <div class="falling-figure" aria-hidden="true">
    <svg viewBox="0 0 200 520" fill="none" xmlns="http://www.w3.org/2000/svg" class="figure-svg">
      <!-- Head -->
      <circle cx="105" cy="42" r="22" fill="currentColor"/>

      <!-- Torso — slightly arched back, arms reaching -->
      <path d="
        M 95 62
        C 90 90, 85 130, 80 170
        L 70 170
        C 75 130, 80 90, 85 62
        Z
      " fill="currentColor"/>

      <!-- Left arm — flung outward/up -->
      <path d="
        M 85 75
        C 60 60, 30 45, 5 55
        L 3 48
        C 28 35, 58 50, 83 68
        Z
      " fill="currentColor"/>

      <!-- Right arm — reaching down/out -->
      <path d="
        M 95 80
        C 120 95, 155 120, 185 105
        L 188 112
        C 158 130, 122 105, 95 88
        Z
      " fill="currentColor"/>

      <!-- Coat/jacket flap — billowing fabric -->
      <path d="
        M 80 100
        C 75 130, 65 165, 55 195
        C 50 205, 58 208, 65 200
        C 70 175, 75 145, 80 115
        Z
      " fill="currentColor" opacity="0.7"/>
      <path d="
        M 72 170
        C 65 200, 55 240, 45 260
        C 40 268, 48 272, 55 265
        C 60 245, 68 210, 74 180
        Z
      " fill="currentColor" opacity="0.5"/>

      <!-- Left leg — bent at knee, relaxed -->
      <path d="
        M 78 165
        C 70 210, 55 260, 40 310
        C 35 330, 25 360, 20 380
        L 12 378
        C 18 358, 28 328, 33 308
        C 48 258, 63 208, 70 168
        Z
      " fill="currentColor"/>

      <!-- Left foot -->
      <path d="
        M 20 378
        L 12 378
        C 5 390, 2 400, 8 405
        L 22 400
        C 25 395, 24 388, 20 380
        Z
      " fill="currentColor"/>

      <!-- Right leg — extended, trailing -->
      <path d="
        M 82 168
        C 90 220, 100 290, 110 360
        C 115 400, 120 440, 118 470
        L 108 468
        C 110 438, 107 398, 102 358
        C 92 288, 85 220, 76 170
        Z
      " fill="currentColor"/>

      <!-- Right foot -->
      <path d="
        M 118 468
        L 108 468
        C 106 480, 108 490, 115 495
        L 125 492
        C 128 487, 125 478, 118 470
        Z
      " fill="currentColor"/>
    </svg>
  </div>

  {/* Falling through the history of human knowledge — ancient to absurd */}
  <div class="falling-text">
    <div class="word-carousel" aria-hidden="true">

      {/* ═══ ~3000 BCE — BABYLON & EGYPT ═══ cute, simple, innocent */}
      <span class="drift-word font-display">1 + 1 = 2</span>
      <span class="drift-word font-display">A = lw</span>
      <span class="drift-word font-display">A = ½bh</span>
      <span class="drift-word font-display">C = πd</span>
      <span class="drift-word font-display">A = πr²</span>

      {/* ═══ ~500 BCE — PYTHAGORAS, EUCLID ═══ */}
      <span class="drift-word font-display">a² + b² = c²</span>
      <span class="drift-word font-display">π ≈ 3.14159...</span>
      <span class="drift-word font-display">∠A + ∠B + ∠C = 180°</span>
      <span class="drift-word font-display">V = ⅓πr²h</span>
      <span class="drift-word font-display">primes: 2, 3, 5, 7, 11, 13...</span>

      {/* ═══ ~250 BCE — ARCHIMEDES ═══ */}
      <span class="drift-word font-display">F_b = ρVg</span>
      <span class="drift-word font-display">τ = r × F</span>
      <span class="drift-word font-display">A = 4πr²</span>
      <span class="drift-word font-display">V = ⁴⁄₃πr³</span>

      {/* ═══ 1600s — GALILEO ═══ getting warmer */}
      <span class="drift-word font-display">d = ½gt²</span>
      <span class="drift-word font-display">v = v₀ + at</span>
      <span class="drift-word font-display">T = 2π√(l/g)</span>

      {/* ═══ 1600s — KEPLER ═══ */}
      <span class="drift-word font-display">T² ∝ a³</span>
      <span class="drift-word font-display">dA/dt = const</span>

      {/* ═══ 1687 — NEWTON ═══ here we go */}
      <span class="drift-word font-display">F = ma</span>
      <span class="drift-word font-display">F = G(m₁m₂)/r²</span>
      <span class="drift-word font-display">p = mv</span>
      <span class="drift-word font-display">v = √(GM/r)</span>
      <span class="drift-word font-display">T² = 4π²a³/GM</span>
      <span class="drift-word font-display">g = GM/r²</span>
      <span class="drift-word font-display">L = r × p</span>
      <span class="drift-word font-display">df/dx = lim(Δx→0) Δf/Δx</span>
      <span class="drift-word font-display">∫₀¹ x² dx = ⅓</span>

      {/* ═══ 1700s — EULER, BERNOULLI ═══ */}
      <span class="drift-word font-display">e^(iπ) + 1 = 0</span>
      <span class="drift-word font-display">P + ½ρv² + ρgh = const</span>
      <span class="drift-word font-display">i² = −1</span>
      <span class="drift-word font-display">φ = 1.61803398...</span>

      {/* ═══ 1800s — THERMODYNAMICS ═══ */}
      <span class="drift-word font-display">ΔU = Q − W</span>
      <span class="drift-word font-display">dS/dt ≥ 0</span>
      <span class="drift-word font-display">PV = nRT</span>
      <span class="drift-word font-display">S = k ln W</span>
      <span class="drift-word font-display">η = 1 − Tc/Th</span>
      <span class="drift-word font-display">ΔG = ΔH − TΔS</span>

      {/* ═══ 1800s — ELECTROMAGNETISM (Faraday, Maxwell) ═══ getting real */}
      <span class="drift-word font-display">V = IR</span>
      <span class="drift-word font-display">F = kq₁q₂/r²</span>
      <span class="drift-word font-display">ε = −dΦ/dt</span>
      <span class="drift-word font-display">∇ · E = ρ/ε₀</span>
      <span class="drift-word font-display">∇ · B = 0</span>
      <span class="drift-word font-display">∇ × E = −∂B/∂t</span>
      <span class="drift-word font-display">∇ × B = μ₀J + μ₀ε₀∂E/∂t</span>
      <span class="drift-word font-display">F = q(E + v × B)</span>
      <span class="drift-word font-display">c = 1/√(μ₀ε₀) = 299,792,458 m/s</span>

      {/* ═══ 1800s — WAVES & OPTICS ═══ */}
      <span class="drift-word font-display">v = fλ</span>
      <span class="drift-word font-display">n₁sinθ₁ = n₂sinθ₂</span>
      <span class="drift-word font-display">d sinθ = mλ</span>
      <span class="drift-word font-display">λmax = b/T</span>
      <span class="drift-word font-display">N = N₀e^(−λt)</span>
      <span class="drift-word font-display">t½ = ln2/λ</span>

      {/* ═══ 1900s — PLANCK, BOHR ═══ things start getting weird */}
      <span class="drift-word font-display">E = hf</span>
      <span class="drift-word font-display">E = nhf</span>
      <span class="drift-word font-display">λ = h/mv</span>
      <span class="drift-word font-display">Δt = 2L/c</span>

      {/* ═══ 1905 — EINSTEIN (special relativity) ═══ buckle up */}
      <span class="drift-word font-display">— everything is relative —</span>
      <span class="drift-word font-display">E = mc²</span>
      <span class="drift-word font-display">t' = t/√(1 − v²/c²)</span>
      <span class="drift-word font-display">γ = 1/√(1 − v²/c²)</span>
      <span class="drift-word font-display">x' = γ(x − vt)</span>
      <span class="drift-word font-display">t' = γ(t − vx/c²)</span>
      <span class="drift-word font-display">E² = (pc)² + (mc²)²</span>
      <span class="drift-word font-display">p = mv/√(1 − v²/c²)</span>
      <span class="drift-word font-display">ds² = −c²dt² + dx² + dy² + dz²</span>

      {/* ═══ 1915 — EINSTEIN (general relativity) ═══ now we're cooking */}
      <span class="drift-word font-display">Rμν − ½gμνR + Λgμν = 8πG/c⁴ Tμν</span>
      <span class="drift-word font-display">rs = 2GM/c²</span>
      <span class="drift-word font-display">Δφ = 6πGM/ac²(1 − e²)</span>
      <span class="drift-word font-display">ds² = −(1 − rs/r)c²dt² + (1 − rs/r)⁻¹dr² + r²dΩ²</span>

      {/* ═══ 1920s-30s — QUANTUM MECHANICS ═══ reality breaks */}
      <span class="drift-word font-display">iℏ∂ψ/∂t = Ĥψ</span>
      <span class="drift-word font-display">ΔxΔp ≥ ℏ/2</span>
      <span class="drift-word font-display">ΔEΔt ≥ ℏ/2</span>
      <span class="drift-word font-display">Ĥ|ψ⟩ = E|ψ⟩</span>
      <span class="drift-word font-display">[x̂, p̂] = iℏ</span>
      <span class="drift-word font-display">ψ(x,t) = Ae^(ikx−iωt)</span>
      <span class="drift-word font-display">P = |⟨φ|ψ⟩|²</span>
      <span class="drift-word font-display">⟨x⟩ = ∫ψ*xψ dx</span>
      <span class="drift-word font-display">|ψ⟩ = α|0⟩ + β|1⟩</span>
      <span class="drift-word font-display">|🐱⟩ = α|alive⟩ + β|dead⟩</span>
      <span class="drift-word font-display">(iγᵘ∂μ − m)ψ = 0</span>

      {/* ═══ 1945 — THE BOMB DROPS ═══ */}
      <span class="drift-word font-display">²³⁵U + n → ⁹²Kr + ¹⁴¹Ba + 3n + 200 MeV</span>
      <span class="drift-word font-display">E = Δmc² = 8.4 × 10¹³ J/kg</span>
      <span class="drift-word font-display">k_eff = k_∞ · P_f · P_th — criticality</span>
      <span class="drift-word font-display">N(t) = N₀ · e^((k−1)t/l) — chain reaction</span>
      <span class="drift-word font-display">²H + ³H → ⁴He + n + 17.6 MeV</span>
      <span class="drift-word font-display">July 16, 1945 — 05:29:45 MWT</span>
      <span class="drift-word font-display">Y = 21 kt TNT</span>

      {/* ═══ 1948 — SHANNON, INFORMATION ═══ */}
      <span class="drift-word font-display">H = −Σ p(x) log₂ p(x)</span>
      <span class="drift-word font-display">C = B log₂(1 + S/N)</span>

      {/* ═══ 1960s-70s — COSMOLOGY, BLACK HOLES ═══ getting long... */}
      <span class="drift-word font-display">v = H₀d</span>
      <span class="drift-word font-display">H₀ = 67.4 km/s/Mpc</span>
      <span class="drift-word font-display">ρc = 3H₀²/8πG</span>
      <span class="drift-word font-display">T_CMB = 2.72548 ± 0.00057 K</span>
      <span class="drift-word font-display">S_BH = kc³A/4Għ</span>
      <span class="drift-word font-display">T_H = ℏc³/8πGMk_B</span>
      <span class="drift-word font-display">L = 4πR²σT⁴</span>
      <span class="drift-word font-display">MCh = 5.83 M☉/μe²</span>

      {/* ═══ 1970s — STANDARD MODEL ═══ oh no */}
      <span class="drift-word font-display">ℒ = −¼FᵃμνFᵃᵘᵛ + iψ̄γᵘDμψ + ψ̄ᵢyᵢⱼψⱼφ + h.c. + |Dμφ|² − V(φ)</span>
      <span class="drift-word font-display">SU(3) × SU(2) × U(1)</span>
      <span class="drift-word font-display">V(φ) = μ²φ†φ + λ(φ†φ)²</span>
      <span class="drift-word font-display">m_H = 125.25 ± 0.17 GeV/c²</span>

      {/* ═══ 1980s — CHAOS, LORENZ ═══ */}
      <span class="drift-word font-display">dx/dt = σ(y − x), dy/dt = x(ρ − z) − y, dz/dt = xy − βz</span>
      <span class="drift-word font-display">xₙ₊₁ = rxₙ(1 − xₙ)</span>
      <span class="drift-word font-display">δ = 4.669201609...</span>

      {/* ═══ 1990s-2000s — MODERN COSMOLOGY ═══ */}
      <span class="drift-word font-display">Ωm + ΩΛ + Ωk = 1, where Ωm ≈ 0.315, ΩΛ ≈ 0.685</span>
      <span class="drift-word font-display">ds² = −c²dt² + a(t)²[dr²/(1−kr²) + r²dΩ²]</span>
      <span class="drift-word font-display">(ȧ/a)² = 8πGρ/3 − kc²/a² + Λc²/3</span>

      {/* ═══ QUANTUM FIELD THEORY ═══ lmao good luck */}
      <span class="drift-word font-display">{"⟨Ω|T{φ(x₁)φ(x₂)...φ(xₙ)}|Ω⟩ = ∫𝒟φ φ(x₁)...φ(xₙ) e^(iS[φ]/ℏ) / ∫𝒟φ e^(iS[φ]/ℏ)"}</span>
      <span class="drift-word font-display">S = ∫d⁴x [−¼FμνFᵘᵛ + ψ̄(iγᵘDμ − m)ψ]</span>
      <span class="drift-word font-display">Γ(n→n') = 2π/ℏ |⟨n'|Ĥ'|n⟩|² ρ(E_n')</span>
      <span class="drift-word font-display">β(g) = μ∂g/∂μ = −(11N−2Nf)/48π² g³ + O(g⁵)</span>

      {/* ═══ EUV LITHOGRAPHY ═══ we made the light do what?? */}
      <span class="drift-word font-display">λ = 13.5 nm — EUV</span>
      <span class="drift-word font-display">CD = k₁ · λ/NA — resolution limit</span>
      <span class="drift-word font-display">Sn plasma → 13.5nm photon → Mo/Si mirror × 11 → 7nm transistor</span>
      <span class="drift-word font-display">NA = 0.55, 250W source, 160 WPH — High-NA EUV</span>

      {/* ═══ STRING THEORY ═══ absolutely unhinged */}
      <span class="drift-word font-display">S = −(1/4πα') ∫d²σ √−h hᵃᵇ∂ₐXᵘ∂ᵦXᵛGμν(X)</span>
      <span class="drift-word font-display">S_IIB = (1/2κ₁₀²) ∫d¹⁰x √−g [e⁻²ᶲ(R + 4(∂φ)² − ½|H₃|²) − ½|F₁|² − ½|F̃₃|² − ¼|F̃₅|²] + S_CS + S_loc</span>

      {/* ═══ AdS/CFT ═══ we've left earth */}
      <span class="drift-word font-display">Z_string[φ₀] = ⟨exp(∫d⁴x φ₀(x)𝒪(x))⟩_CFT = Z_gravity[φ→φ₀ at boundary]</span>
      <span class="drift-word font-display">S_EE = Area(γ_A)/4G_N^(d+2) — Ryu-Takayanagi</span>

      {/* ═══ QUANTUM GRAVITY ═══ god help us */}
      <span class="drift-word font-display">Z = ∫𝒟g_μν 𝒟φ exp(i/ℏ ∫d⁴x √−g [R/16πG + ℒ_matter(φ, g_μν)])</span>
      <span class="drift-word font-display">Ŝ = (γ₀/4l_P²) Σⱼ √(jⱼ(jⱼ+1)) — LQG area spectrum</span>
      <span class="drift-word font-display">S_total = (1/16πG)∫d⁴x√−g(R − 2Λ) + ∫d⁴x√−g(−¼FᵃμνFᵃᵘᵛ + iψ̄γᵘDμψ + |Dμφ|² − V(φ) + ψ̄ᵢyᵢⱼψⱼφ) + S_GHY + S_ct</span>

      {/* ═══ THE END ═══ we've gone too far */}
      <span class="drift-word font-display">42</span>
    </div>
  </div>

  {/* Scroll indicator */}
  <div class="scroll-hint" aria-hidden="true">
    <div class="scroll-hint-line"></div>
  </div>
</section>

<style>
  /* ===== Container ===== */
  .falling-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: -3rem -1.5rem 0;
    padding: 2rem;
    gap: 2rem;
  }

  /* ===== Wind lines ===== */
  .wind-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .wind-line {
    position: absolute;
    left: var(--x);
    width: 1px;
    height: var(--h, 80px);
    background: linear-gradient(
      to top,
      transparent,
      rgba(255, 255, 255, 0.08) 30%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(255, 255, 255, 0.08) 70%,
      transparent
    );
    animation: wind-rush var(--speed, 1.2s) var(--delay, 0s) linear infinite;
    opacity: 0;
  }

  @keyframes wind-rush {
    0% {
      bottom: -120px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      bottom: 110%;
      opacity: 0;
    }
  }

  /* ===== The falling figure ===== */
  .falling-figure {
    position: relative;
    flex-shrink: 0;
    color: var(--color-ink);
    opacity: 0;
    animation: figure-enter 2s 0.3s ease-out forwards;
  }

  .figure-svg {
    width: 120px;
    height: auto;
    filter: drop-shadow(0 0 40px rgba(255, 184, 77, 0.08));
    animation: figure-drift 8s ease-in-out infinite;
  }

  @keyframes figure-enter {
    0% {
      opacity: 0;
      transform: translateY(-30px) rotate(-8deg);
    }
    100% {
      opacity: 0.85;
      transform: translateY(0) rotate(0deg);
    }
  }

  @keyframes figure-drift {
    0%, 100% {
      transform: rotate(-2deg) translateX(0px) translateY(0px);
    }
    25% {
      transform: rotate(1deg) translateX(5px) translateY(-8px);
    }
    50% {
      transform: rotate(-1deg) translateX(-3px) translateY(4px);
    }
    75% {
      transform: rotate(2deg) translateX(4px) translateY(-5px);
    }
  }

  /* ===== Text ===== */
  .falling-text {
    position: relative;
    z-index: 2;
    text-align: left;
    height: 80vh;
    width: clamp(280px, 40vw, 500px);
    flex-shrink: 1;
  }

  /* ===== Word carousel — equations drift upward like he's falling past the universe's source code ===== */
  .word-carousel {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, white 15%, white 85%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, white 15%, white 85%, transparent);
  }

  .drift-word {
    position: absolute;
    font-size: clamp(0.85rem, 1.8vw, 1.2rem);
    font-style: italic;
    color: var(--color-ink);
    opacity: 0;
    white-space: nowrap;
    animation: word-drift var(--drift-speed, 12s) var(--drift-delay, 0s) linear forwards;
    left: var(--drift-x, 0%);
  }

  @keyframes word-drift {
    0% {
      top: 105%;
      opacity: 0;
    }
    0.5% {
      opacity: 0.35;
    }
    2.5% {
      opacity: 0.12;
    }
    4.5% {
      opacity: 0.35;
    }
    5% {
      top: -8%;
      opacity: 0;
    }
    100% {
      top: -8%;
      opacity: 0;
    }
  }

  @keyframes text-fade {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Scroll hint ===== */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: text-fade 1s 3.5s ease forwards;
  }

  .scroll-hint-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% {
      opacity: 0.4;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.8;
      transform: scaleY(1.3);
    }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .wind-line,
    .falling-figure,
    .figure-svg,
    .falling-quote,
    .scroll-hint,
    .scroll-hint-line,
    .drift-word {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .drift-word { opacity: 0.15; position: static; }
    .word-carousel { height: auto; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; overflow: visible; mask-image: none; -webkit-mask-image: none; }
  }

