---
/**
 * FallingHero — the falling man.
 *
 * Full-viewport cinematic intro: a silhouette tumbles through void,
 * wind lines stream upward, the quote fades in.
 * Pure CSS animation — no libraries, no JS (except scroll hint dismiss).
 */
---

<section class="falling-hero" id="falling-hero">
  {/* Wind lines — vertical streaks rushing upward to sell the fall */}
  <div class="wind-lines" aria-hidden="true">
    <div class="wind-line" style="--x: 8%; --delay: 0s; --speed: 1.1s; --h: 90px;"></div>
    <div class="wind-line" style="--x: 15%; --delay: 0.7s; --speed: 1.4s; --h: 60px;"></div>
    <div class="wind-line" style="--x: 23%; --delay: 0.3s; --speed: 0.9s; --h: 110px;"></div>
    <div class="wind-line" style="--x: 31%; --delay: 1.1s; --speed: 1.3s; --h: 70px;"></div>
    <div class="wind-line" style="--x: 40%; --delay: 0.5s; --speed: 1.0s; --h: 85px;"></div>
    <div class="wind-line" style="--x: 52%; --delay: 0.2s; --speed: 1.5s; --h: 55px;"></div>
    <div class="wind-line" style="--x: 61%; --delay: 0.9s; --speed: 1.1s; --h: 100px;"></div>
    <div class="wind-line" style="--x: 70%; --delay: 1.3s; --speed: 0.8s; --h: 75px;"></div>
    <div class="wind-line" style="--x: 78%; --delay: 0.4s; --speed: 1.2s; --h: 65px;"></div>
    <div class="wind-line" style="--x: 87%; --delay: 0.8s; --speed: 1.0s; --h: 95px;"></div>
    <div class="wind-line" style="--x: 93%; --delay: 1.5s; --speed: 1.3s; --h: 50px;"></div>
  </div>

  {/* The falling figure */}
  <div class="falling-figure" aria-hidden="true">
    <svg viewBox="0 0 200 520" fill="none" xmlns="http://www.w3.org/2000/svg" class="figure-svg">
      <!-- Head -->
      <circle cx="105" cy="42" r="22" fill="currentColor"/>

      <!-- Torso — slightly arched back, arms reaching -->
      <path d="
        M 95 62
        C 90 90, 85 130, 80 170
        L 70 170
        C 75 130, 80 90, 85 62
        Z
      " fill="currentColor"/>

      <!-- Left arm — flung outward/up -->
      <path d="
        M 85 75
        C 60 60, 30 45, 5 55
        L 3 48
        C 28 35, 58 50, 83 68
        Z
      " fill="currentColor"/>

      <!-- Right arm — reaching down/out -->
      <path d="
        M 95 80
        C 120 95, 155 120, 185 105
        L 188 112
        C 158 130, 122 105, 95 88
        Z
      " fill="currentColor"/>

      <!-- Coat/jacket flap — billowing fabric -->
      <path d="
        M 80 100
        C 75 130, 65 165, 55 195
        C 50 205, 58 208, 65 200
        C 70 175, 75 145, 80 115
        Z
      " fill="currentColor" opacity="0.7"/>
      <path d="
        M 72 170
        C 65 200, 55 240, 45 260
        C 40 268, 48 272, 55 265
        C 60 245, 68 210, 74 180
        Z
      " fill="currentColor" opacity="0.5"/>

      <!-- Left leg — bent at knee, relaxed -->
      <path d="
        M 78 165
        C 70 210, 55 260, 40 310
        C 35 330, 25 360, 20 380
        L 12 378
        C 18 358, 28 328, 33 308
        C 48 258, 63 208, 70 168
        Z
      " fill="currentColor"/>

      <!-- Left foot -->
      <path d="
        M 20 378
        L 12 378
        C 5 390, 2 400, 8 405
        L 22 400
        C 25 395, 24 388, 20 380
        Z
      " fill="currentColor"/>

      <!-- Right leg — extended, trailing -->
      <path d="
        M 82 168
        C 90 220, 100 290, 110 360
        C 115 400, 120 440, 118 470
        L 108 468
        C 110 438, 107 398, 102 358
        C 92 288, 85 220, 76 170
        Z
      " fill="currentColor"/>

      <!-- Right foot -->
      <path d="
        M 118 468
        L 108 468
        C 106 480, 108 490, 115 495
        L 125 492
        C 128 487, 125 478, 118 470
        Z
      " fill="currentColor"/>
    </svg>
  </div>

  {/* Equations, constants, concepts — drifting upward like he's falling past the universe's source code */}
  <div class="falling-text">
    <div class="word-carousel" aria-hidden="true">
      {/* === Fundamental equations === */}
      <span class="drift-word font-display">E = mc²</span>
      <span class="drift-word font-display">F = ma</span>
      <span class="drift-word font-display">F = G(m₁m₂)/r²</span>
      <span class="drift-word font-display">E = hf</span>
      <span class="drift-word font-display">λ = h/mv</span>
      <span class="drift-word font-display">PV = nRT</span>
      <span class="drift-word font-display">S = k ln W</span>
      <span class="drift-word font-display">∇ × E = −∂B/∂t</span>
      <span class="drift-word font-display">∇ · E = ρ/ε₀</span>
      <span class="drift-word font-display">∇ × B = μ₀J + μ₀ε₀∂E/∂t</span>
      <span class="drift-word font-display">∇ · B = 0</span>
      <span class="drift-word font-display">iℏ∂ψ/∂t = Ĥψ</span>
      <span class="drift-word font-display">ΔxΔp ≥ ℏ/2</span>
      <span class="drift-word font-display">Rμν − ½gμνR = 8πGTμν</span>
      <span class="drift-word font-display">ds² = −c²dt² + dx² + dy² + dz²</span>
      <span class="drift-word font-display">t' = t/√(1 − v²/c²)</span>
      <span class="drift-word font-display">E² = (pc)² + (mc²)²</span>
      <span class="drift-word font-display">p = mv/√(1 − v²/c²)</span>
      <span class="drift-word font-display">dS/dt ≥ 0</span>
      <span class="drift-word font-display">∂ρ/∂t + ∇·(ρv) = 0</span>

      {/* === Lorentz equations & transforms === */}
      <span class="drift-word font-display">F = q(E + v × B)</span>
      <span class="drift-word font-display">x' = γ(x − vt)</span>
      <span class="drift-word font-display">t' = γ(t − vx/c²)</span>
      <span class="drift-word font-display">γ = 1/√(1 − v²/c²)</span>

      {/* === Photon clock / light === */}
      <span class="drift-word font-display">c = 299,792,458 m/s</span>
      <span class="drift-word font-display">Δt = 2L/c</span>
      <span class="drift-word font-display">E = nhf</span>
      <span class="drift-word font-display">λmax = b/T</span>

      {/* === Thermodynamics === */}
      <span class="drift-word font-display">ΔU = Q − W</span>
      <span class="drift-word font-display">η = 1 − Tc/Th</span>
      <span class="drift-word font-display">ΔG = ΔH − TΔS</span>
      <span class="drift-word font-display">F = U − TS</span>

      {/* === Quantum & particle === */}
      <span class="drift-word font-display">ψ(x,t) = Ae^(ikx−iωt)</span>
      <span class="drift-word font-display">⟨x⟩ = ∫ψ*xψ dx</span>
      <span class="drift-word font-display">Ĥ|ψ⟩ = E|ψ⟩</span>
      <span class="drift-word font-display">[x̂, p̂] = iℏ</span>
      <span class="drift-word font-display">|ψ⟩ = α|0⟩ + β|1⟩</span>
      <span class="drift-word font-display">P = |⟨φ|ψ⟩|²</span>
      <span class="drift-word font-display">ΔEΔt ≥ ℏ/2</span>
      <span class="drift-word font-display">S = −Tr(ρ ln ρ)</span>

      {/* === Gravity & orbits === */}
      <span class="drift-word font-display">v = √(GM/r)</span>
      <span class="drift-word font-display">T² = 4π²a³/GM</span>
      <span class="drift-word font-display">Δφ = 6πGM/ac²</span>
      <span class="drift-word font-display">rs = 2GM/c²</span>
      <span class="drift-word font-display">g = GM/r²</span>
      <span class="drift-word font-display">Ω = √(GM/r³)</span>
      <span class="drift-word font-display">L = r × p</span>
      <span class="drift-word font-display">ε = √(1 + 2EL²/G²M²m³)</span>

      {/* === Waves & optics === */}
      <span class="drift-word font-display">v = fλ</span>
      <span class="drift-word font-display">n₁sinθ₁ = n₂sinθ₂</span>
      <span class="drift-word font-display">d sinθ = mλ</span>
      <span class="drift-word font-display">I = I₀cos²θ</span>
      <span class="drift-word font-display">Δλ/λ = v/c</span>

      {/* === Electromagnetism === */}
      <span class="drift-word font-display">V = IR</span>
      <span class="drift-word font-display">P = IV</span>
      <span class="drift-word font-display">Φ = ∮B·dA</span>
      <span class="drift-word font-display">ε = −dΦ/dt</span>
      <span class="drift-word font-display">F = kq₁q₂/r²</span>
      <span class="drift-word font-display">U = ½CV²</span>

      {/* === Fluid dynamics === */}
      <span class="drift-word font-display">P + ½ρv² + ρgh = const</span>
      <span class="drift-word font-display">Re = ρvL/μ</span>
      <span class="drift-word font-display">F = −6πμrv</span>

      {/* === Cosmology === */}
      <span class="drift-word font-display">H₀ = 67.4 km/s/Mpc</span>
      <span class="drift-word font-display">v = H₀d</span>
      <span class="drift-word font-display">ρc = 3H²/8πG</span>
      <span class="drift-word font-display">Ω = ρ/ρc</span>
      <span class="drift-word font-display">a(t) ~ e^(Ht)</span>
      <span class="drift-word font-display">T = 2.725 K</span>
      <span class="drift-word font-display">z = λobs/λemit − 1</span>

      {/* === Constants === */}
      <span class="drift-word font-display">G = 6.674 × 10⁻¹¹</span>
      <span class="drift-word font-display">ℏ = 1.055 × 10⁻³⁴ J·s</span>
      <span class="drift-word font-display">k = 1.381 × 10⁻²³ J/K</span>
      <span class="drift-word font-display">e = 1.602 × 10⁻¹⁹ C</span>
      <span class="drift-word font-display">α = 1/137.036</span>
      <span class="drift-word font-display">NA = 6.022 × 10²³</span>

      {/* === Famous numbers & ratios === */}
      <span class="drift-word font-display">π = 3.14159265...</span>
      <span class="drift-word font-display">φ = 1.61803398...</span>
      <span class="drift-word font-display">e = 2.71828182...</span>
      <span class="drift-word font-display">√2 = 1.41421356...</span>
      <span class="drift-word font-display">i² = −1</span>
      <span class="drift-word font-display">e^(iπ) + 1 = 0</span>

      {/* === Information & computation === */}
      <span class="drift-word font-display">H = −Σp log p</span>
      <span class="drift-word font-display">I = log₂(1/p)</span>
      <span class="drift-word font-display">C = B log₂(1 + S/N)</span>

      {/* === Chaos & nonlinear === */}
      <span class="drift-word font-display">dx/dt = σ(y − x)</span>
      <span class="drift-word font-display">dy/dt = x(ρ − z) − y</span>
      <span class="drift-word font-display">dz/dt = xy − βz</span>
      <span class="drift-word font-display">xₙ₊₁ = rxₙ(1 − xₙ)</span>
      <span class="drift-word font-display">δ = 4.66920...</span>

      {/* === Nuclear & particle === */}
      <span class="drift-word font-display">E = Δmc²</span>
      <span class="drift-word font-display">N = N₀e^(−λt)</span>
      <span class="drift-word font-display">t½ = ln2/λ</span>
      <span class="drift-word font-display">²H + ³H → ⁴He + n</span>

      {/* === Astrophysics === */}
      <span class="drift-word font-display">L = 4πR²σT⁴</span>
      <span class="drift-word font-display">M☉ = 1.989 × 10³⁰ kg</span>
      <span class="drift-word font-display">1 AU = 1.496 × 10¹¹ m</span>
      <span class="drift-word font-display">1 ly = 9.461 × 10¹⁵ m</span>
      <span class="drift-word font-display">MCh = 1.4 M☉</span>

      {/* === Cool concepts as text === */}
      <span class="drift-word font-display">spacetime</span>
      <span class="drift-word font-display">entropy</span>
      <span class="drift-word font-display">singularity</span>
      <span class="drift-word font-display">event horizon</span>
      <span class="drift-word font-display">dark energy</span>
      <span class="drift-word font-display">quantum foam</span>
      <span class="drift-word font-display">cosmic inflation</span>
      <span class="drift-word font-display">superposition</span>
      <span class="drift-word font-display">entanglement</span>
      <span class="drift-word font-display">antimatter</span>
      <span class="drift-word font-display">neutron star</span>
      <span class="drift-word font-display">gravitational waves</span>
      <span class="drift-word font-display">time dilation</span>
      <span class="drift-word font-display">frame dragging</span>
      <span class="drift-word font-display">Hawking radiation</span>
      <span class="drift-word font-display">Chandrasekhar limit</span>
      <span class="drift-word font-display">Planck length</span>
      <span class="drift-word font-display">cosmic microwave background</span>
      <span class="drift-word font-display">vacuum energy</span>
      <span class="drift-word font-display">geodesic</span>
      <span class="drift-word font-display">light cone</span>
      <span class="drift-word font-display">Fermi paradox</span>
      <span class="drift-word font-display">Boltzmann brain</span>
      <span class="drift-word font-display">Penrose process</span>
      <span class="drift-word font-display">spaghettification</span>
    </div>
  </div>

  {/* Scroll indicator */}
  <div class="scroll-hint" aria-hidden="true">
    <div class="scroll-hint-line"></div>
  </div>
</section>

<style>
  /* ===== Container ===== */
  .falling-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: -3rem -1.5rem 0;
    padding: 2rem;
    gap: 2rem;
  }

  /* ===== Wind lines ===== */
  .wind-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .wind-line {
    position: absolute;
    left: var(--x);
    width: 1px;
    height: var(--h, 80px);
    background: linear-gradient(
      to top,
      transparent,
      rgba(255, 255, 255, 0.08) 30%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(255, 255, 255, 0.08) 70%,
      transparent
    );
    animation: wind-rush var(--speed, 1.2s) var(--delay, 0s) linear infinite;
    opacity: 0;
  }

  @keyframes wind-rush {
    0% {
      bottom: -120px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      bottom: 110%;
      opacity: 0;
    }
  }

  /* ===== The falling figure ===== */
  .falling-figure {
    position: relative;
    flex-shrink: 0;
    color: var(--color-ink);
    opacity: 0;
    animation: figure-enter 2s 0.3s ease-out forwards;
  }

  .figure-svg {
    width: 120px;
    height: auto;
    filter: drop-shadow(0 0 40px rgba(255, 184, 77, 0.08));
    animation: figure-drift 8s ease-in-out infinite;
  }

  @keyframes figure-enter {
    0% {
      opacity: 0;
      transform: translateY(-30px) rotate(-8deg);
    }
    100% {
      opacity: 0.85;
      transform: translateY(0) rotate(0deg);
    }
  }

  @keyframes figure-drift {
    0%, 100% {
      transform: rotate(-2deg) translateX(0px) translateY(0px);
    }
    25% {
      transform: rotate(1deg) translateX(5px) translateY(-8px);
    }
    50% {
      transform: rotate(-1deg) translateX(-3px) translateY(4px);
    }
    75% {
      transform: rotate(2deg) translateX(4px) translateY(-5px);
    }
  }

  /* ===== Text ===== */
  .falling-text {
    position: relative;
    z-index: 2;
    text-align: left;
    height: 80vh;
    width: clamp(280px, 40vw, 500px);
    flex-shrink: 1;
  }

  /* ===== Word carousel — equations drift upward like he's falling past the universe's source code ===== */
  .word-carousel {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, white 15%, white 85%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, white 15%, white 85%, transparent);
  }

  .drift-word {
    position: absolute;
    font-size: clamp(0.85rem, 1.8vw, 1.2rem);
    font-style: italic;
    color: var(--color-ink);
    opacity: 0;
    white-space: nowrap;
    animation: word-drift var(--drift-speed, 12s) var(--drift-delay, 0s) linear infinite;
    left: var(--drift-x, 0%);
  }

  @keyframes word-drift {
    0% {
      top: 105%;
      opacity: 0;
    }
    5% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.12;
    }
    95% {
      opacity: 0.35;
    }
    100% {
      top: -8%;
      opacity: 0;
    }
  }

  @keyframes text-fade {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Scroll hint ===== */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: text-fade 1s 3.5s ease forwards;
  }

  .scroll-hint-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% {
      opacity: 0.4;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.8;
      transform: scaleY(1.3);
    }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .wind-line,
    .falling-figure,
    .figure-svg,
    .falling-quote,
    .scroll-hint,
    .scroll-hint-line,
    .drift-word {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .drift-word { opacity: 0.15; position: static; }
    .word-carousel { height: auto; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; overflow: visible; mask-image: none; -webkit-mask-image: none; }
  }

  /* ===== Responsive ===== */

  /* Mobile: stack vertically, figure on top */
  @media (max-width: 767px) {
    .falling-hero {
      flex-direction: column;
      gap: 0;
    }
    .falling-text {
      text-align: center;
      width: 100%;
      height: 50vh;
    }
  }

  @media (min-width: 768px) {
    .figure-svg {
      width: 160px;
    }
    .falling-hero {
      gap: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .figure-svg {
      width: 180px;
    }
    .falling-hero {
      gap: 6rem;
    }
  }
</style>

<script>
  // Assign randomized delays and positions so 100+ equations stagger naturally
  const words = document.querySelectorAll('.drift-word');
  const total = words.length;
  // Total cycle time — spread all words across this window so ~4-5 are visible at once
  const cycleDuration = total * 1.1; // seconds between each word appearing
  words.forEach((el, i) => {
    const htmlEl = el as HTMLElement;
    const delay = (i * cycleDuration / total) + (Math.random() * 0.5);
    const speed = 10 + Math.random() * 6; // 10-16s drift time
    const x = Math.random() * 60; // 0-60% from left
    htmlEl.style.setProperty('--drift-delay', `${delay.toFixed(1)}s`);
    htmlEl.style.setProperty('--drift-speed', `${speed.toFixed(1)}s`);
    htmlEl.style.setProperty('--drift-x', `${x.toFixed(0)}%`);
  });
</script>
