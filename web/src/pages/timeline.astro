---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.tsx";
import { allConcepts, stats } from "../lib/concepts.ts";
---

<BaseLayout title="Timeline — So Far So Good" nav="timeline">
  <section class="mb-10">
    <div class="eyebrow text-accent mb-3">View · Timeline</div>
    <h2
      class="font-display text-4xl md:text-5xl font-semibold tracking-tight leading-tight max-w-3xl"
    >
      Every NIAC concept, plotted across {stats.yearMax - stats.yearMin + 1} years
    </h2>
    <p class="mt-4 text-base text-dim max-w-2xl leading-relaxed">
      Each dot is one concept. Columns show how dense each year was; color
      shows the funding phase. The shape of the chart is the rhythm of NIAC
      itself — when ideas got proposed, when they hit Phase II, when the
      program leaned hard into a research wave.
    </p>
    <div class="flex gap-3 mt-6">
      <a
        href="/"
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border border-transparent text-dim hover:text-white hover:border-amber-400/40 transition"
      >
        Search
      </a>
      <span
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border text-accent"
        style="border-color: var(--color-accent-dim); background: rgba(255, 184, 77, 0.06);"
      >
        Timeline
      </span>
      <a
        href="/atlas"
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border border-transparent text-dim hover:text-white hover:border-amber-400/40 transition"
      >
        Atlas
      </a>
      <a
        href="/subjects"
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border border-transparent text-dim hover:text-white hover:border-amber-400/40 transition"
      >
        Subjects
      </a>
    </div>
  </section>

  <Timeline concepts={allConcepts} client:load />
</BaseLayout>
