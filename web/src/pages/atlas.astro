---
import BaseLayout from "../layouts/BaseLayout.astro";
import Atlas from "../components/Atlas.tsx";
import { allConcepts } from "../lib/concepts.ts";
---

<BaseLayout title="Atlas — So Far So Good" nav="atlas">
  <section class="mb-10">
    <div class="eyebrow text-accent mb-3">View · Atlas</div>
    <h2
      class="font-display text-4xl md:text-5xl font-semibold tracking-tight leading-tight max-w-3xl"
    >
      Wander the imagined future
    </h2>
    <p class="mt-4 text-base text-dim max-w-2xl leading-relaxed">
      Every concept as a node, every research lineage and topical neighbor as
      an edge. Drag a node and watch the cluster reorganize. Click to read.
      The dense knots are where research communities are forming around an
      idea — usually propulsion, habitats, or far-side astronomy.
    </p>
    <div class="flex gap-3 mt-6">
      <a
        href="/"
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border border-transparent text-dim hover:text-white hover:border-amber-400/40 transition"
      >
        Search
      </a>
      <a
        href="/timeline"
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border border-transparent text-dim hover:text-white hover:border-amber-400/40 transition"
      >
        Timeline
      </a>
      <span
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border text-accent"
        style="border-color: var(--color-accent-dim); background: rgba(255, 184, 77, 0.06);"
      >
        Atlas
      </span>
      <a
        href="/subjects"
        class="px-3 py-1.5 text-[0.65rem] uppercase tracking-widest font-mono rounded border border-transparent text-dim hover:text-white hover:border-amber-400/40 transition"
      >
        Subjects
      </a>
    </div>
  </section>

  <Atlas concepts={allConcepts} client:only="react" />
</BaseLayout>
