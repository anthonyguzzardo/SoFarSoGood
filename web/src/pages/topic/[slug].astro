---
/**
 * Topic deep dive — a curated, long-form exploration of a scientific frontier.
 *
 * Each topic page is a hand-crafted entry point into a big question:
 * black holes, gravity, quantum physics, propulsion, telescopes. It pulls
 * together an overview, open questions, a historical timeline, curated media
 * (Veritasium, Dwarkesh, books, docs), and links to related NIAC concepts.
 *
 * These pages are the "Veritasium layer" of the atlas — they make you care
 * about a topic before sending you into the primary sources.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  allTopics,
  getTopic,
  getTopicConcepts,
  getRelatedTopics,
  mediaIcon,
} from "../../lib/topics.ts";
import { excerpt, piLine } from "../../lib/concepts.ts";

export function getStaticPaths() {
  return allTopics.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const topic = getTopic(slug!);
if (!topic) throw new Error(`Topic not found: ${slug}`);

const concepts = getTopicConcepts(topic);
const relatedTopics = getRelatedTopics(topic);

// Split overview into paragraphs.
const overviewParagraphs = topic.overview
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<BaseLayout
  title={`${topic.title} — So Far So Good`}
  description={topic.subtitle}
  nav="explore"
>
  <article>
    {/* ----------------------------------------------------------- */}
    {/* Breadcrumb                                                  */}
    {/* ----------------------------------------------------------- */}
    <a
      href="/explore"
      class="eyebrow hover:text-white inline-flex items-center gap-1"
    >
      ← All topics
    </a>

    {/* ----------------------------------------------------------- */}
    {/* Header                                                      */}
    {/* ----------------------------------------------------------- */}
    <header class="mt-6 mb-16 max-w-4xl hero-glow">
      <div class="eyebrow text-accent mb-3">Deep dive</div>
      <h1
        class="font-display text-5xl md:text-7xl font-semibold tracking-tight leading-[1.05]"
      >
        {topic.title}
      </h1>
      <p
        class="mt-6 font-display text-xl md:text-2xl text-dim leading-relaxed max-w-3xl"
      >
        {topic.subtitle}
      </p>
    </header>

    {/* ----------------------------------------------------------- */}
    {/* Overview                                                    */}
    {/* ----------------------------------------------------------- */}
    <section class="mb-20 max-w-3xl">
      <div class="space-y-4 text-base leading-relaxed">
        {overviewParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    {/* ----------------------------------------------------------- */}
    {/* The Math — key equations (collapsible)                      */}
    {/* ----------------------------------------------------------- */}
    {
      topic.equations && topic.equations.length > 0 && (
        <section class="mb-20 max-w-3xl">
          <details open>
            <summary class="eyebrow text-accent mb-4 pb-2 border-b hairline cursor-pointer select-none hover:text-white transition">
              The math — key equations
            </summary>
            <div class="grid gap-4 mt-6">
              {topic.equations.map((eq) => (
                <div
                  class="p-5 rounded-lg border hairline"
                  style="background: var(--color-paper-raised);"
                >
                  <div class="font-mono text-[0.65rem] uppercase tracking-[0.18em] mb-3" style="color: var(--color-ink-dim);">
                    {eq.name}
                  </div>
                  <div class="font-display text-lg md:text-xl leading-relaxed py-2 text-center" style="color: var(--color-ink);">
                    {eq.equation}
                  </div>
                  <div class="text-sm leading-relaxed mt-3" style="color: var(--color-ink-dim);">
                    {eq.note}
                  </div>
                </div>
              ))}
            </div>
          </details>
        </section>
      )
    }

    {/* ----------------------------------------------------------- */}
    {/* Open questions                                              */}
    {/* ----------------------------------------------------------- */}
    <section class="mb-20">
      <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
        Open questions — what we still don't know
      </div>
      <ul class="space-y-4 max-w-3xl">
        {
          topic.openQuestions.map((q) => (
            <li class="flex gap-3">
              <span
                class="text-accent font-mono text-lg leading-snug shrink-0"
                aria-hidden="true"
              >
                ?
              </span>
              <span class="text-base leading-relaxed">{q}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ----------------------------------------------------------- */}
    {/* Misconceptions                                              */}
    {/* ----------------------------------------------------------- */}
    {
      topic.misconceptions?.length > 0 && (
        <section class="mb-20">
          <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
            Common misconceptions — what most people get wrong
          </div>
          <div class="space-y-6 max-w-3xl">
            {topic.misconceptions.map((m) => (
              <div
                class="p-5 rounded-lg border hairline"
                style="background: var(--color-paper-raised);"
              >
                <div class="flex gap-3 items-start mb-3">
                  <span class="text-red-400 font-mono text-sm shrink-0 mt-0.5">✗</span>
                  <p class="text-base leading-relaxed">{m.claim}</p>
                </div>
                <div class="flex gap-3 items-start">
                  <span class="text-green-400 font-mono text-sm shrink-0 mt-0.5">✓</span>
                  <p class="text-base leading-relaxed text-dim">{m.reality}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* ----------------------------------------------------------- */}
    {/* Unsolved problems                                           */}
    {/* ----------------------------------------------------------- */}
    {
      topic.unsolvedProblems?.length > 0 && (
        <section class="mb-20">
          <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
            Unsolved problems — where we're stuck
          </div>
          <div class="space-y-10 max-w-3xl">
            {topic.unsolvedProblems.map((p) => (
              <div
                class="p-6 rounded-lg border hairline"
                style="background: var(--color-paper-raised);"
              >
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h4 class="font-display text-xl font-semibold leading-snug">
                    {p.name}
                  </h4>
                  <span
                    class:list={[
                      "shrink-0 px-2 py-0.5 rounded text-xs font-mono uppercase tracking-wider",
                      p.status === "open"
                        ? "text-red-400 border border-red-400/30"
                        : p.status === "partially-resolved"
                          ? "text-amber-400 border border-amber-400/30"
                          : "text-green-400 border border-green-400/30",
                    ]}
                  >
                    {p.status === "partially-resolved"
                      ? "partial"
                      : p.status}
                  </span>
                </div>
                <div class="eyebrow mb-3">
                  Posed {p.yearPosed} · {p.posedBy} ·{" "}
                  {new Date().getFullYear() - p.yearPosed} years open
                </div>
                <p class="text-sm text-dim leading-relaxed mb-4">
                  {p.significance}
                </p>

                {p.milestones.length > 0 && (
                  <div class="mt-4 pt-4 border-t hairline">
                    <div class="eyebrow mb-3">Progress</div>
                    <ul class="space-y-2">
                      {p.milestones.map((m) => (
                        <li class="flex gap-3 text-sm">
                          <span class="eyebrow text-accent shrink-0 w-12">
                            {m.year}
                          </span>
                          <span class="text-dim leading-relaxed">
                            {m.event}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* ----------------------------------------------------------- */}
    {/* Thought experiments                                         */}
    {/* ----------------------------------------------------------- */}
    {
      topic.thoughtExperiments?.length > 0 && (
        <section class="mb-20">
          <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
            Thought experiments — the ideas that shaped the field
          </div>
          <div class="space-y-8 max-w-3xl">
            {topic.thoughtExperiments.map((te) => (
              <div>
                <h4 class="font-display text-xl font-semibold mb-1">
                  {te.name}
                </h4>
                <div class="eyebrow mb-3">
                  {te.yearProposed} · {te.proposedBy}
                </div>
                <p class="text-base leading-relaxed mb-3">{te.description}</p>
                <div
                  class="p-4 rounded border hairline text-sm"
                  style="background: var(--color-paper-raised);"
                >
                  <span class="eyebrow text-accent">Modern status</span>
                  <p class="mt-1 text-dim leading-relaxed">
                    {te.modernStatus}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* ----------------------------------------------------------- */}
    {/* Historical timeline                                         */}
    {/* ----------------------------------------------------------- */}
    <section class="mb-20">
      <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
        Timeline — how we got here
      </div>
      <div class="relative pl-8 max-w-3xl">
        {/* Vertical line */}
        <div
          class="absolute left-3 top-0 bottom-0 w-px"
          style="background: var(--color-paper-edge);"
        >
        </div>

        <ul class="space-y-6">
          {
            topic.timeline.map((entry) => (
              <li class="relative">
                {/* Dot on the line */}
                <div
                  class="absolute -left-5 top-1.5 w-2.5 h-2.5 rounded-full border-2"
                  style="border-color: var(--color-accent); background: var(--color-paper);"
                />
                <div class="eyebrow text-accent mb-1">{entry.year}</div>
                <div class="text-sm leading-relaxed">{entry.event}</div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ----------------------------------------------------------- */}
    {/* Curated media                                               */}
    {/* ----------------------------------------------------------- */}
    {
      topic.media.length > 0 && (
        <section class="mb-20">
          <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
            Go deeper — curated media
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl">
            {topic.media.map((m) => (
              <li>
                <a
                  href={m.url}
                  target="_blank"
                  rel="noopener"
                  class="block group p-4 rounded-lg border hairline hover:border-amber-400/40 transition"
                  style="background: var(--color-paper-raised);"
                >
                  <div class="flex items-start gap-3">
                    <span
                      class="text-lg shrink-0 mt-0.5"
                      aria-hidden="true"
                    >
                      {mediaIcon(m.type as any)}
                    </span>
                    <div>
                      <div class="font-display text-base font-medium leading-snug group-hover:text-accent transition-colors">
                        {m.title}
                      </div>
                      <div class="eyebrow mt-1">
                        {m.source} · {m.type}
                      </div>
                      <p class="mt-2 text-sm text-dim leading-relaxed">
                        {m.note}
                      </p>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ----------------------------------------------------------- */}
    {/* Related NIAC concepts                                       */}
    {/* ----------------------------------------------------------- */}
    {
      concepts.length > 0 && (
        <section class="mb-20">
          <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
            Funded concepts related to {topic.title.toLowerCase()}
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-8 max-w-4xl">
            {concepts.map((c) => (
              <li>
                <a href={`/concept/${c.slug}`} class="block group">
                  <div class="eyebrow mb-1">
                    {c.year}
                    {c.phase && (
                      <span class="text-accent"> · Phase {c.phase}</span>
                    )}
                    <span> · {piLine(c)}</span>
                  </div>
                  <h4 class="font-display text-lg font-semibold leading-snug group-hover:underline">
                    {c.title}
                  </h4>
                  <p class="mt-2 text-sm text-dim leading-relaxed">
                    {excerpt(c.abstract, 180)}
                  </p>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <a
              href={`/?q=${encodeURIComponent(topic.searchTerms[0] ?? topic.title)}`}
              class="eyebrow text-accent hover:text-white inline-flex items-center gap-2 transition"
            >
              Search all concepts for "{topic.searchTerms[0] ?? topic.title}" →
            </a>
          </div>
        </section>
      )
    }

    {/* ----------------------------------------------------------- */}
    {/* Related topics                                              */}
    {/* ----------------------------------------------------------- */}
    {
      relatedTopics.length > 0 && (
        <section class="mt-32 pt-12 border-t hairline">
          <div class="flex items-baseline justify-between mb-8">
            <h3 class="font-display text-2xl font-semibold">
              Keep exploring
            </h3>
            <span class="eyebrow">related topics</span>
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedTopics.map((rt) => (
              <li>
                <a
                  href={`/topic/${rt.slug}`}
                  class="block group p-6 rounded-lg border hairline hover:border-amber-400/40 transition"
                  style="background: var(--color-paper-raised);"
                >
                  <h4 class="font-display text-xl font-semibold group-hover:text-accent transition-colors">
                    {rt.title}
                  </h4>
                  <p class="mt-2 text-sm text-dim leading-relaxed">
                    {rt.subtitle}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
