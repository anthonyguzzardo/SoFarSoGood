---
/**
 * /wishlist — "The Hunt"
 *
 * Every paper we want indexed, from 1800 BCE to 2024. Reframed as an
 * active quest with progress visualization, sort modes, and a one-field
 * contribution form. The most ambitious page on the site.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import WishlistBrowser from "../components/WishlistBrowser.tsx";
import WishlistTimeline from "../components/WishlistTimeline.tsx";
import Stat from "../components/Stat.astro";
import {
  allWishlistEntries,
  allEras,
  allFields,
  eraLabel,
  fieldLabel,
  fieldColors,
  eraColors,
  wishlistStats,
  displayYear,
} from "../lib/wishlist.ts";
import { connectionsByWishlistId, connectedWishlistIds } from "../lib/connections.ts";

const eraLabels = Object.fromEntries(allEras.map((e) => [e, eraLabel(e)]));
const fieldLabels = Object.fromEntries(allFields.map((f) => [f, fieldLabel(f)]));

/* Sort fields by count descending for progress bars */
const sortedFields = [...allFields].sort(
  (a, b) => (wishlistStats.byField[b] ?? 0) - (wishlistStats.byField[a] ?? 0)
);

const connectedIds = [...connectedWishlistIds];
---

<BaseLayout
  title="The Hunt — So Far So Good"
  description={`${wishlistStats.total} scientific papers spanning ${Math.abs(wishlistStats.oldestYear) + wishlistStats.newestYear} years — help us find them all.`}
  nav="wishlist"
>
  {/* ----------------------------------------------------------- */}
  {/* Header                                                      */}
  {/* ----------------------------------------------------------- */}
  <section class="mb-12 reveal">
    <div class="eyebrow text-accent mb-3">THE HUNT</div>
    <h2
      class="font-display text-4xl md:text-5xl font-semibold tracking-tight leading-tight max-w-4xl"
    >
      {wishlistStats.total} papers. {Math.abs(wishlistStats.oldestYear) + wishlistStats.newestYear} years of human knowledge. Help us find them.
    </h2>
    <p class="mt-4 text-base text-dim max-w-3xl leading-relaxed">
      From a Babylonian clay tablet in 1800 BCE to DESI dark energy measurements
      in 2024. Every paper marked "unfound" is one we haven't tracked down yet.
      Paste a URL, claim a paper, make the index a little more complete.{" "}
      <span class="text-accent font-mono text-xs uppercase tracking-widest">So far so good.</span>
    </p>
  </section>

  {/* ----------------------------------------------------------- */}
  {/* Stats                                                       */}
  {/* ----------------------------------------------------------- */}
  <section class="mb-12 reveal reveal-delay-1">
    <div
      class="surface rounded-lg px-6 py-5 grid grid-cols-2 md:grid-cols-5 gap-y-4 gap-x-6"
    >
      <Stat value={wishlistStats.total} label="total targets" />
      <Stat value={wishlistStats.wanted} label="unfound" />
      <Stat value={wishlistStats.indexed + wishlistStats.acquired} label="recovered" />
      <Stat
        value={`${displayYear(wishlistStats.oldestYear)}–${wishlistStats.newestYear}`}
        label="time span"
      />
      <Stat value={connectedIds.length} label="linked to NASA concepts" />
    </div>
  </section>

  {/* ----------------------------------------------------------- */}
  {/* Field progress bars                                         */}
  {/* ----------------------------------------------------------- */}
  <section class="mb-16 reveal reveal-delay-2">
    <div class="eyebrow text-accent mb-4 pb-2 border-b hairline">
      Progress by field
    </div>
    <div class="space-y-3">
      {
        sortedFields.map((f) => {
          const progress = wishlistStats.byFieldProgress[f];
          const total = progress?.total ?? 0;
          const found = progress?.found ?? 0;
          const pct = total > 0 ? (found / total) * 100 : 0;
          const color = fieldColors[f] ?? "var(--color-accent)";
          return (
            <div class="flex items-center gap-4">
              <span
                class="text-xs font-mono w-28 shrink-0 text-right"
                style={`color: ${color};`}
              >
                {fieldLabel(f)}
              </span>
              <div
                class="flex-1 h-2 rounded-full overflow-hidden"
                style="background: rgba(255,255,255,0.04);"
              >
                <div
                  class="h-full rounded-full transition-all"
                  style={`width: ${Math.max(pct, 0)}%; background: ${color}; opacity: 0.7; min-width: ${pct > 0 ? '4px' : '0'};`}
                />
              </div>
              <span
                class="text-xs font-mono w-14 shrink-0"
                style="color: var(--color-ink-dim);"
              >
                {found}/{total}
              </span>
            </div>
          );
        })
      }
    </div>
  </section>

  {/* ----------------------------------------------------------- */}
  {/* Timeline — "The River of Knowledge"                         */}
  {/* ----------------------------------------------------------- */}
  <section class="mb-16 reveal">
    <div class="eyebrow text-accent mb-3">The River of Knowledge</div>
    <p class="text-sm text-dim mb-6 max-w-3xl leading-relaxed">
      {Math.abs(wishlistStats.oldestYear) + wishlistStats.newestYear} years of
      human scientific knowledge. Each dot is a paper. Each cluster is a
      revolution. Click any dot to jump to its card below.
    </p>
    <div
      class="surface rounded-lg p-4 overflow-x-auto"
    >
      <WishlistTimeline
        entries={allWishlistEntries}
        fieldColors={fieldColors}
        eraColors={eraColors}
        eraLabels={eraLabels}
        eras={allEras}
        connectedIds={connectedIds}
        client:load
      />
    </div>
  </section>

  {/* ----------------------------------------------------------- */}
  {/* Browse all (interactive React island)                       */}
  {/* ----------------------------------------------------------- */}
  <section>
    <div
      class="flex items-baseline justify-between mb-6 pb-4 border-b hairline"
    >
      <h3 class="font-display text-2xl font-semibold">
        The full list
      </h3>
      <span class="eyebrow">search · sort · filter</span>
    </div>
    <WishlistBrowser
      entries={allWishlistEntries}
      eras={allEras}
      fields={allFields}
      eraLabels={eraLabels}
      fieldLabels={fieldLabels}
      connectionsByPaperId={connectionsByWishlistId}
      connectedIds={connectedIds}
      client:load
    />
  </section>
</BaseLayout>
