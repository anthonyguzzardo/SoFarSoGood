---
/**
 * /paths — index of curated reading paths.
 *
 * Each path is a narrative thread connecting historical papers, topic deep
 * dives, and NIAC concepts into a coherent journey. The "follow the thread"
 * experience that makes browsing addictive.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { allReadingPaths } from "../lib/reading-paths.ts";
---

<BaseLayout
  title="Paths — So Far So Good"
  description={`${allReadingPaths.length} curated reading paths through the history of science — from ancient manuscripts to NASA's most ambitious concepts.`}
  nav="paths"
>
  <section class="mb-12 reveal">
    <div class="eyebrow text-accent mb-3">Reading Paths</div>
    <h2
      class="font-display text-4xl md:text-5xl font-semibold tracking-tight leading-tight max-w-4xl"
    >
      Follow the thread
    </h2>
    <p class="mt-4 text-base text-dim max-w-3xl leading-relaxed">
      Curated journeys connecting ancient discoveries to modern NASA research.
      Each path traces an idea across centuries — from the paper where it was
      born to the NASA concept that's trying to make it real.
    </p>
  </section>

  <section>
    <ul class="grid grid-cols-1 gap-6">
      {
        allReadingPaths.map((p, i) => (
          <li class:list={["reveal", `reveal-delay-${Math.min(i + 1, 3)}`]}>
            <a
              href={`/path/${p.slug}`}
              class="block group p-8 md:p-10 rounded-lg border hairline hover:border-amber-400/40 transition"
              style="background: var(--color-paper-raised);"
            >
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="flex-1">
                  <div class="eyebrow text-accent mb-2">
                    {p.steps.length} stops · {p.tags.join(" · ")}
                  </div>
                  <h3 class="font-display text-2xl md:text-3xl font-semibold leading-snug group-hover:text-accent transition-colors">
                    {p.title}
                  </h3>
                  <p class="mt-3 text-base text-dim leading-relaxed max-w-2xl">
                    {p.subtitle}
                  </p>
                  <div class="mt-6 eyebrow text-accent group-hover:gap-3 inline-flex items-center gap-2 transition-all">
                    <span>Follow the thread</span>
                    <span>→</span>
                  </div>
                </div>

                {/* Step preview — show the types of items in the path */}
                <div class="flex gap-2 md:mt-2 shrink-0">
                  {p.steps.map((s, si) => (
                    <div
                      class="w-8 h-8 rounded-full border hairline flex items-center justify-center text-xs"
                      style={{
                        color:
                          s.type === "concept"
                            ? "var(--color-accent)"
                            : s.type === "topic"
                              ? "#2dd4bf"
                              : "var(--color-ink-dim)",
                        borderColor:
                          s.type === "concept"
                            ? "rgba(255, 184, 77, 0.3)"
                            : s.type === "topic"
                              ? "rgba(45, 212, 191, 0.3)"
                              : "var(--color-paper-edge)",
                        fontFamily: "var(--font-mono)",
                      }}
                      title={`${s.type}: ${s.ref}`}
                    >
                      {si + 1}
                    </div>
                  ))}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
