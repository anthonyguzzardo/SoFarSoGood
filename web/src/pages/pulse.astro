---
/**
 * Pulse — the trending board.
 *
 * Shows what the world is talking about across the topics in the atlas.
 * Data sourced from Reddit and Hacker News, refreshed at build time.
 *
 * Structure:
 *   1. Header with stats
 *   2. PulseBoard leaderboard (interactive React island)
 *   3. Top sources grid — best content across platforms
 *   4. Rising concepts — atlas concepts linked to trending topics
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import PulseBoard from "../components/PulseBoard.tsx";
import {
  allPulseTopics,
  activePulseTopics,
  generatedAt,
  topicHistory,
} from "../lib/pulse.ts";
import { allConcepts, categorize, piLine, categoryLabel } from "../lib/concepts.ts";

/* Collect rising concepts from active trending topics.
   Pulse uses short slugs (e.g. "fluidic-telescope") while the atlas uses
   long auto-generated slugs. We do a startsWith match to bridge them. */
type TrendInfo = { topicLabel: string; delta: number; direction: string; score: number };
const conceptToTrend = new Map<string, TrendInfo>();

function findConceptByShortSlug(shortSlug: string) {
  return allConcepts.find((c) => c.slug.startsWith(shortSlug));
}

const risingConceptSet = new Map<string, typeof allConcepts[0]>();
for (const t of activePulseTopics) {
  for (const shortSlug of t.relatedConceptSlugs) {
    const concept = findConceptByShortSlug(shortSlug);
    if (!concept) continue;

    risingConceptSet.set(concept.slug, concept);

    // Keep the highest-scoring topic association
    const existing = conceptToTrend.get(concept.slug);
    if (!existing || t.score > existing.score) {
      conceptToTrend.set(concept.slug, {
        topicLabel: t.label, delta: t.delta, direction: t.direction, score: t.score,
      });
    }
  }
}

const risingConcepts = [...risingConceptSet.values()].slice(0, 6);

/* Build a concept resolution map for PulseBoard's expanded row links.
   Maps short slugs → { fullSlug, title } so the React island can render
   correct links and human-readable labels. */
const conceptMap: Record<string, { slug: string; title: string }> = {};
for (const t of allPulseTopics) {
  for (const shortSlug of t.relatedConceptSlugs) {
    if (conceptMap[shortSlug]) continue;
    const concept = findConceptByShortSlug(shortSlug);
    if (concept) {
      conceptMap[shortSlug] = { slug: concept.slug, title: concept.title };
    }
  }
}

/* Narrative lede is now reactive inside PulseBoard — updates with time window */
---

<BaseLayout title="Pulse — what the world is talking about" nav="pulse">
  {/* ----------------------------------------------------------------- */}
  {/* Header                                                            */}
  {/* ----------------------------------------------------------------- */}
  <section class="pt-4 md:pt-8 pb-12">
    <div class="max-w-4xl">
      <p
        class="hero-line text-accent font-mono text-sm uppercase tracking-[0.2em]"
        style="animation-delay: 0s"
      >
        The Pulse
      </p>

      <h2
        class="hero-line mt-4 font-display text-3xl md:text-5xl font-semibold tracking-tight leading-[1.08]"
        style="animation-delay: 0.15s"
      >
        What the world is thinking about
      </h2>

      <p
        class="hero-line mt-4 font-display text-lg md:text-xl leading-relaxed max-w-2xl"
        style="animation-delay: 0.3s; color: var(--color-ink-dim);"
      >
        Aggregated from Reddit + Hacker News + ArXiv. Scored by momentum.
      </p>
    </div>
  </section>

  {/* ----------------------------------------------------------------- */}
  {/* The leaderboard                                                   */}
  {/* ----------------------------------------------------------------- */}
  <section class="mb-24 reveal">
    <div class="eyebrow text-accent mb-6">Trending now</div>
    <div
      class="rounded-xl border p-2 md:p-4"
      style="background: var(--color-paper-raised); border-color: var(--color-paper-edge);"
    >
      <PulseBoard
        topics={allPulseTopics}
        generatedAt={generatedAt}
        conceptMap={conceptMap}
        topicHistory={topicHistory}
        client:load
      />
    </div>
  </section>

  {/* "The Signal" section is now inside PulseBoard — reacts to time window toggle */}

  {/* ----------------------------------------------------------------- */}
  {/* Rising concepts — atlas entries linked to trending topics          */}
  {/* ----------------------------------------------------------------- */}
  {risingConcepts.length > 0 && (
    <section class="mb-24 reveal">
      <div class="eyebrow text-accent mb-6">Rising in the atlas</div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {risingConcepts.map((c) => {
          const cat = categorize(c);
          const trend = conceptToTrend.get(c.slug);
          const arrow = trend?.direction === "up" ? "▲" : trend?.direction === "down" ? "▼" : "—";
          const deltaStr = trend && trend.delta !== 0
            ? `${trend.delta > 0 ? "+" : ""}${trend.delta}%`
            : null;
          const badgeColor = trend?.direction === "up"
            ? { bg: "rgba(74, 222, 128, 0.10)", border: "rgba(74, 222, 128, 0.25)", text: "#4ade80" }
            : trend?.direction === "down"
              ? { bg: "rgba(248, 113, 113, 0.10)", border: "rgba(248, 113, 113, 0.25)", text: "#f87171" }
              : { bg: "rgba(255, 184, 77, 0.10)", border: "rgba(255, 184, 77, 0.25)", text: "var(--color-accent)" };

          return (
            <a href={`/concept/${c.slug}`} class="concept-card group relative">
              {/* Momentum badge — overlaid top-right */}
              {trend && (
                <div
                  class="absolute -top-2 -right-2 z-10 flex items-center gap-1 px-2.5 py-1 rounded-full text-[0.65rem] font-mono font-semibold backdrop-blur-sm"
                  style={`background: ${badgeColor.bg}; border: 1px solid ${badgeColor.border}; color: ${badgeColor.text}; box-shadow: 0 2px 8px rgba(0,0,0,0.3);`}
                >
                  <span>{arrow}</span>
                  {deltaStr && <span>{deltaStr}</span>}
                </div>
              )}

              {/* Trending topic link — what's driving this concept */}
              {trend && (
                <div
                  class="mb-2 text-[0.6rem] font-mono uppercase tracking-widest"
                  style="color: var(--color-accent); opacity: 0.7;"
                >
                  Trending via {trend.topicLabel}
                </div>
              )}

              <div class="card-tags">
                <span class="card-tag tag-funded">Funded</span>
                {c.phase && (
                  <span class="card-tag tag-meta">Phase {c.phase}</span>
                )}
                <span class="card-tag tag-meta">
                  {categoryLabel[cat] ?? cat}
                </span>
              </div>
              {c.whatIfItWorks ? (
                <p class="mt-4 font-display text-lg font-semibold leading-snug">
                  {c.whatIfItWorks}
                </p>
              ) : (
                <p class="mt-4 font-display text-lg font-semibold leading-snug">
                  {c.title}
                </p>
              )}
              <div class="card-subtitle mt-3">
                {piLine(c)} · {c.year}
              </div>
              <div class="mt-auto pt-4 card-cta">
                <span>Explore concept</span>
                <span class="arrow">&rarr;</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>
